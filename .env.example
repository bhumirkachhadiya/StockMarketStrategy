# ==============================================================================
# Fib-Precision Indian Stock Market Trading Platform - Environment Configuration
# ==============================================================================

# Application Port (Default: 8080 or assigned by cloud host like Render/Railway)
PORT=8080

# Flask Secret Key for session signing
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# Angel One SmartAPI Credentials
# Generate API Key at: https://smartapi.angelone.in/
ANGEL_API_KEY=your_angel_one_api_key_here
ANGEL_CLIENT_ID=your_client_code_here
ANGEL_PIN=your_trading_pin_here

# Optional: Google Authenticator Base32 Secret Key for automated TOTP generation
# If provided, the system automatically calculates the 6-digit TOTP without manual input
ANGEL_TOTP_SECRET=your_authenticator_base32_secret_here

# Database URL (Optional: defaults to local SQLite platform.db)
# For PostgreSQL (e.g., Supabase / Neon / Render PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Scanner Configuration
SCANNER_REFRESH_SECONDS=5
PROXIMITY_THRESHOLD_PCT=0.10
